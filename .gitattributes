# Normalise line endings so a mixed Windows/macOS/Linux team does not fight the diff.
* text=auto eol=lf

# Windows-native tooling
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary - never touched, never diffed as text
*.parquet binary
*.db      binary
*.pdf     binary
*.png     binary
*.jpg     binary
*.woff2   binary

# Generated: keep them out of diff noise and out of language stats
docs/architecture/*.excalidraw  -diff linguist-generated
frontend/package-lock.json      -diff linguist-generated
data/output/**                  linguist-generated
