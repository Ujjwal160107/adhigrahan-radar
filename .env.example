# Copy to .env and adjust. Nothing here is a secret; the app has no credentials.

# Path to the SQLite build artifact the API reads.
# Default resolves to data/output/vivaad.db relative to the repo root.
VIVAAD_DB=data/output/vivaad.db

# Frontend -> API base URL (used by frontend/src/api/client.ts).
VITE_API_URL=http://localhost:8000

# Optional: override where backend/fallback.py looks for tier-2 cached JSON.
# Default resolves to data/output/fallback relative to the repo root.
# VIVAAD_FALLBACK_DIR=data/output/fallback

# Optional: comma-separated CORS origins the API accepts. Default is the two
# localhost dev origins used by `make web`.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
