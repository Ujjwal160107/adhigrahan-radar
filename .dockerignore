# Build-context filter for Dockerfile.api and Dockerfile.web.
#
# The API image runs `python pipeline/run_all.py --skip-handoff` at build time, so this file must
# NEVER exclude the pipeline's inputs: data/input/ (the committed parquet contract), data/raw/ (the
# committed gazette mirror), pipeline/, backend/ (backend/schema.sql is the build's schema source)
# and requirements.txt. What it excludes is everything that is either machine-local or a *product*
# of the build (`make build` writes data/output/vivaad.db, data/output/fallback/ and
# data/intermediate/, all git-ignored): shipping those would bake one machine's artifacts into the
# image instead of the ones this build produces, and pipeline/s14_load_risk_db.py refuses to load a
# database whose schema predates a schema.sql change rather than migrating it.

# Version control / editors
.git
.gitattributes
.gitignore
.github
.vscode
.idea
Thumbs.db
.DS_Store

# Python environments and caches
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Node modules and the Vite build output (the web image builds it from source in its own stage)
frontend/node_modules
frontend/dist
frontend/.vite
node_modules

# Generated build products - regenerated by the pipeline inside the image
data/intermediate
data/output/vivaad.db
data/output/vivaad.db-journal
data/output/vivaad.db-wal
data/output/vivaad.db-shm
data/output/fallback

# Fetched-at-runtime source caches: megabytes of re-fetchable gazette PDFs and a rebuilt CA bundle
# (`make ingest`). data/raw/'s *parsed* JSON beside them is committed and IS needed.
data/raw/egazette/pdf
data/raw/.cache

# Local environment files (none of them carry a secret - the app has no credentials - but they are
# machine-specific). Same rule as .gitignore: the tracked .env.example stays, the rest goes.
.env
.env.*
!.env.example

# Docker's own files
Dockerfile.api
Dockerfile.web
.dockerignore
